    "기본 컬렉션과 별도 상품": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sold separately from the Base Collection"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 컬렉션과 별도 상품"
