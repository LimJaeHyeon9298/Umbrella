{
  "sourceLanguage": "en",
  "strings": {
    "%@ · %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@"
          }
        }
      }
    },
    "%@, 잠김, 1분 미리듣기 가능": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, locked, 1-minute preview available"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, 잠김, 1분 미리듣기 가능"
          }
        }
      }
    },
    "%@에 소리가 서서히 꺼져요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sound fades out at %@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 소리가 서서히 꺼져요."
          }
        }
      }
    },
    "%@에 열기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock for %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 열기"
          }
        }
      }
    },
    "15분": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "15 min"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "15분"
          }
        }
      }
    },
    "1분 미리듣기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview for 1 Minute"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1분 미리듣기"
          }
        }
      }
    },
    "25분 동안 집중해 볼까요?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ready for 25 minutes of focus?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "25분 동안 집중해 볼까요?"
          }
        }
      }
    },
    "25분 집중하고 5분 쉬는 것을 반복해요. 켜 두는 동안 화면이 꺼지지 않아요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repeats 25 minutes of focus and a 5-minute break. Your screen stays on while it runs."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "25분 집중하고 5분 쉬는 것을 반복해요. 켜 두는 동안 화면이 꺼지지 않아요."
          }
        }
      }
    },
    "30분": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "30 min"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "30분"
          }
        }
      }
    },
    "5분 동안 쉬어 가세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a 5-minute break."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "5분 동안 쉬어 가세요."
          }
        }
      }
    },
    "60분": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "60 min"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "60분"
          }
        }
      }
    },
    "가격을 불러오는 중": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading price…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가격을 불러오는 중"
          }
        }
      }
    },
    "개인정보처리방침": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy Policy"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인정보처리방침"
          }
        }
      }
    },
    "구매": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purchases"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매"
          }
        }
      }
    },
    "구매 내역을 불러오지 못했어요. 잠시 후 다시 시도해 주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t load your purchases. Please try again later."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매 내역을 불러오지 못했어요. 잠시 후 다시 시도해 주세요."
          }
        }
      }
    },
    "구매 복원": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore Purchases"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매 복원"
          }
        }
      }
    },
    "구매 안 한 상태로 보기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show as Not Purchased"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매 안 한 상태로 보기"
          }
        }
      }
    },
    "구매를 복원했어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purchases restored."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매를 복원했어요."
          }
        }
      }
    },
    "구매를 완료하지 못했어요. 잠시 후 다시 시도해 주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The purchase couldn’t be completed. Please try again later."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매를 완료하지 못했어요. 잠시 후 다시 시도해 주세요."
          }
        }
      }
    },
    "기본 컬렉션 열기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock the Base Collection"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 컬렉션 열기"
          }
